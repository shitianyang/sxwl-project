<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.sxwl</groupId>
        <artifactId>sxwl-boot</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>sxwl-boot-app</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- 认证授权模块 -->
        <dependency>
            <groupId>com.sxwl</groupId>
            <artifactId>sxwl-boot-module-auth</artifactId>
        </dependency>
        <!-- 系统管理模块 -->
        <dependency>
            <groupId>com.sxwl</groupId>
            <artifactId>sxwl-boot-module-system</artifactId>
        </dependency>
        <!-- 代码生成器模块 -->
        <dependency>
            <groupId>com.sxwl</groupId>
            <artifactId>sxwl-boot-module-codegen</artifactId>
        </dependency>
        <!-- 文件存储模块（RustFS） -->
        <dependency>
            <groupId>com.sxwl</groupId>
            <artifactId>sxwl-boot-module-rustfs</artifactId>
        </dependency>
        <!-- 系统配置模块 -->
        <dependency>
            <groupId>com.sxwl</groupId>
            <artifactId>sxwl-boot-module-config</artifactId>
        </dependency>
        <!-- 通知公告模块 -->
        <dependency>
            <groupId>com.sxwl</groupId>
            <artifactId>sxwl-boot-module-notice</artifactId>
        </dependency>
        <!-- 定时任务模块 -->
        <dependency>
            <groupId>com.sxwl</groupId>
            <artifactId>sxwl-boot-module-job</artifactId>
        </dependency>
        <!-- 数据备份模块 -->
        <dependency>
            <groupId>com.sxwl</groupId>
            <artifactId>sxwl-boot-module-backup</artifactId>
        </dependency>
        <!-- SSE 实时推送模块 -->
        <dependency>
            <groupId>com.sxwl</groupId>
            <artifactId>sxwl-boot-module-sse</artifactId>
        </dependency>
        <!-- 测试框架（JUnit 5 + Mockito + Spring Test） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot 打包插件：将应用打包为可执行 JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>